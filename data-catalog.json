    "author": "Unknown",
    "artist": "",
    "synopsis": "'A'k't'o'r' 'f'i'g'u'r'a'n' 'L'e'e' 'H'a'n'j'o',' 'y'a'n'g' 's'e'p'a'n'j'a'n'g' 'h'i'd'u'p'n'y'a' 'h'a'n'y'a' 'b'e'r'm'i'm'p'i' 'b'i's'a' 'h'i'd'u'p' 's'e'h'a'r'i' 's'a'j'a' 's'e'b'a'g'a'i' 'p'r'i'a' 't'a'm'p'a'n',' 'a'k'h'i'r'n'y'a' 'm'e'n'd'a'p'a't'k'a'n' 'k'e's'e'm'p'a't'a'n' 'i't'u'.' 'S'e'b'a'g'a'i' 'h'a'd'i'a'h' 'a't'a's' 'k'e'h'i'd'u'p'a'n'n'y'a' 'y'a'n'g' 's'e'l'a'l'u' 'd'i'j'a'l'a'n'i' 'd'e'n'g'a'n' 't'u'l'u's',' 'i'a' 't'e'r'l'a'h'i'r' 'k'e'm'b'a'l'i' 'd'e'n'g'a'n' 'w'a'j'a'h' 'r'u'p'a'w'a'n' 's'e'r't'a' 's'e'b'u'a'h' 's't'a't'u's' 'w'i'n'd'o'w' 'y'a'n'g' 'd'a'p'a't' 'm'e'n'g'a'b'u'l'k'a'n' 'k'e'i'n'g'i'n'a'n'n'y'a'.' 'M'e's'k'i' 'a'w'a'l'n'y'a' 'i'a' 'h'a'n'y'a'l'a'h' 's'e'o'r'a'n'g' 'b'a'y'i' 'y'a't'i'm' 'p'i'a't'u' 'y'a'n'g' 'd'i't'i'n'g'g'a'l'k'a'n' 'd'i' 'd'e'p'a'n' 'b'i'a'r'a' 'p'a'd'a' 'm'u's'i'm' 'd'i'n'g'i'n',' 't'a'k'd'i'r'n'y'a' 'b'e'r'u'b'a'h' 'd'r'a's't'i's' 'k'e't'i'k'a' 'i'a' 'd'i'a'd'o'p's'i' 'o'l'e'h' 'k'e'l'u'a'r'g'a' 'k'o'n'g'l'o'm'e'r'a't' 'y'a'n'g' 'b'e'r'p'r'o'f'e's'i' 's'e'b'a'g'a'i' 'a'k't'o'r'.' 'H'i'd'u'p' 'b'a'r'u'n'y'a' 'p'u'n' 'd'i'p'e'n'u'h'i' 'k'e'b'e'r'u'n't'u'n'g'a'n' 'y'a'n'g' 't'a'k' 'p'e'r'n'a'h' 'i'a' 'b'a'y'a'n'g'k'a'n' 's'e'b'e'l'u'm'n'y'a'.' 'D'e'n'g'a'n' 'p'e'n'g'a'l'a'm'a'n' 'm'a't'a'n'g' 's'e'o'r'a'n'g' 'a'k't'o'r' 'f'i'g'u'r'a'n' 'y'a'n'g' 't'e'l'a'h' 'm'e'n'c'a'p'a'i' 'p'u'n'c'a'k',' 'd'i't'a'm'b'a'h' 'w'a'j'a'h' 'y'a'n'g' 's'e'o'l'a'h' 'd'i'a'n'u'g'e'r'a'h'k'a'n' 'l'a'n'g's'u'n'g' 'o'l'e'h' 'd'e'w'a',' 'm'u'n'g'k'i'n'k'a'h' 'k'a'l'i' 'i'n'i' 'i'a' 'b'i's'a' 'm'e'n'g'i'n'c'a'r' 'p'o's'i's'i' 't'o'p' 's't'a'r'?'",
