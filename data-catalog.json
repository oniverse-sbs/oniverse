    "synopsis": "'H'a'z'e'l' 'L'o'v'e' 'b'e'r'e'i'n'k'a'r'n'a's'i' 's'e'b'a'g'a'i' 'k'a'r'a'k't'e'r' 'f'i'g'u'r'a'n' 'y'a'n'g' 'd'i't'a'k'd'i'r'k'a'n' 'm'a't'i' 'a'k'i'b'a't' 'k'e'l'e'l'a'h'a'n' 'b'e'k'e'r'j'a'.'\n'\n'I'a' 'b'e'r'h'e'n't'i' 'd'a'r'i' 'p'e'k'e'r'j'a'a'n'n'y'a',' 'm'e'n'd'i'r'i'k'a'n' 'g'u'i'l'd' 's'e'n'd'i'r'i',' 'd'a'n' 'm'e'm'b'a'n'g'u'n' 'k'e'h'i'd'u'p'a'n' 'd'a'm'a'i' 'y'a'n'g' 's'e'l'a'm'a' 'i'n'i' 'i'a' 'i'd'a'm'k'a'n'.'\n'\n'I'a' 'b'a'h'k'a'n' 'm'e'n'i'k'a'h' 'd'e'n'g'a'n' 's'o's'o'k' 's'u'a'm'i' 'i'm'p'i'a'n' 'y'a'n'g' 's'e'm'p'u'r'n'a'—'t'a'm'p'a'n',' 'l'e'm'b'u't',' 'b'e'r'b'a'k'a't',' 'd'a'n' 't'e'r'n'y'a't'a' 's'a'n'g'a't' 'b'e'r'g'a'i'r'a'h'.'\n'\n'N'a'm'u'n',' 'k'e'b'a'h'a'g'i'a'a'n'n'y'a' 'h'a'n'c'u'r' 's'a'a't' 'i'a' 'm'e'n'g'e't'a'h'u'i' 'i'd'e'n't'i't'a's' 'a's'l'i' 's'a'n'g' 's'u'a'm'i':' 'K'y'l'u's' 'H'a'd'i'd',' 's'a'n'g' 'p'e'n'j'a'h'a't' 'u't'a'm'a' 'd'a'l'a'm' 'c'e'r'i't'a' 't'e'r's'e'b'u't'.'\n'\n'L'e'b'i'h' 'b'u'r'u'k' 'l'a'g'i',' 'p'r'i'a' 'i't'u' 'a'd'a'l'a'h' 'd'a'l'a'n'g' 'k'e'j'a'h'a't'a'n' 'y'a'n'g' 'p'e'r'n'a'h' 'i'a' 't'i'p'u';' 'k'i'n'i' 'i'a' 'h'i'd'u'p' 'b'e'r'd'a'm'p'i'n'g'a'n' 'd'e'n'g'a'n' 's'o's'o'k' 'y'a'n'g' 'b'i's'a' 's'a'j'a' 'm'e'm'b'u'n'u'h'n'y'a' 'k'a'p'a'n' 's'a'j'a'.'\n'\n'M'e's'k'i' 'm'e'm'i'l'i'k'i' 's'i's'i' 'y'a'n'g' 'm'e'n'a'k'u't'k'a'n',' 'K'y'l'u's' 'm'e'n'c'u'r'a'h'k'a'n' 'k'a's'i'h' 's'a'y'a'n'g' 'y'a'n'g' 'o'b's'e's'i'f' 'k'e'p'a'd'a' 'H'a'z'e'l' 'd'a'n' 'b'e'r's'i'k'e'r'a's' 'u'n't'u'k' 't'i'd'a'k' 'm'e'l'e'p'a's'k'a'n'n'y'a'.'\n'\n'S'a'a't' 'H'a'z'e'l' 'm'e'm'p'e'r't'i'm'b'a'n'g'k'a'n' 'p'e'r'c'e'r'a'i'a'n',' 's'e'n'y'u'm' 'm'a'n'i's' 'p'r'i'a' 'i't'u' 'm'e'n'e'g'a's'k'a'n' 's'a't'u' 'h'a'l'—'m'e'l'a'r'i'k'a'n' 'd'i'r'i' 'd'a'r'i' 's'u'a'm'i' 'y'a'n'g' 'm'e'r'u'p'a'k'a'n' 'p'e'n'j'a'h'a't' 'i't'u' 'm'u'n'g'k'i'n' 'm'u's't'a'h'i'l' 'd'i'l'a'k'u'k'a'n'.'",
